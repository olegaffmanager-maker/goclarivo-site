# Copy to .env (or export these directly) for a LOCAL test run of
# scripts/onexbet_odds.py. In production (GitHub Actions) these are repo
# Secrets instead — see .github/workflows/rebuild-1xbet-odds.yml. Never
# commit a real .env file.

ONEXBET_CLIENT_ID=
ONEXBET_CLIENT_SECRET=
# Partner ID from the 1xBet account manager. Do NOT use the docs' example
# default of 1 — that's a different account.
ONEXBET_REF=
# Optional — manager declined to provide this as of 2026-10-05 ("look it up
# in the manual"). Odds/matches work without it.
ONEXBET_GR=
